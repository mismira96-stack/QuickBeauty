<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- 상단 툴바 -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        android:background="#1A1A1A">

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:paddingHorizontal="8dp" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toEndOf="@id/btnClose"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="초기화"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="저장"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="#3B82F6"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 프리뷰 영역 -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/bottomControlPanel">

        <com.mismira.quickbeauty.BeautyPreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 원본 보기 뱃지 -->
        <TextView
            android:id="@+id/badgeOriginal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:background="#80000000"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="원본 비교 중"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 화면 길게 누르기 안내 힌트 -->
        <TextView
            android:id="@+id/hintCompare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="#60000000"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="화면을 길게 누르면 원본과 비교할 수 있어요"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />

        <!-- 로딩 바 -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 하단 조절 패널 -->
    <LinearLayout
        android:id="@+id/bottomControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- 슬라이더 및 수치 라벨 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/txtParamName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="❄️ 쿨톤 피부"
                android:textColor="#EEEEEE"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtParamValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#3B82F6"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 조절 시크바 -->
        <SeekBar
            android:id="@+id/seekBarAdjust"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:max="100"
            android:progress="0"
            android:paddingHorizontal="20dp" />

        <!-- 4개 기능 탭 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <LinearLayout
                android:id="@+id/tabCoolTone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="#2C2C2C">
                <TextView
                    android:id="@+id/txtTabCoolTone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❄️ 쿨톤"
                    android:textColor="#3B82F6"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabFaceSlim"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txtTabFaceSlim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 얼굴축소"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabChinSlim"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txtTabChinSlim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ 턱선"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabBodySlim"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txtTabBodySlim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧍 몸매슬림"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>