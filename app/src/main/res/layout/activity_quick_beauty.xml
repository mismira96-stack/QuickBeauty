<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C">

    <!-- 상단 헤더 바 (인셋 + 툴바 영역) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="#0A0A0C">

        <!-- 상태바 & 노치 영역 스페이서 (인셋 전달 전에도 잘림 방지 32dp 안전 기본값) -->
        <View
            android:id="@+id/topBarStatusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <RelativeLayout
            android:id="@+id/topBarContent"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <!-- 닫기 버튼 (×) -->
            <FrameLayout
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_change_photo"
                    android:contentDescription="@string/change_photo" />
            </FrameLayout>

            <!-- 타이틀 -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnClose"
                android:layout_toStartOf="@id/topBarActions"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/app_name"
                android:textColor="#F4F4F5"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- 우측 액션: 리셋(값이 있을 때만 표시) + 저장(단 하나의 강한 블루) -->
            <LinearLayout
                android:id="@+id/topBarActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPrivacyPolicy"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:paddingHorizontal="8dp"
                    android:text="@string/privacy_policy_link"
                    android:textColor="#A1A1AA"
                    android:textSize="10sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnReset"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:paddingHorizontal="10dp"
                    android:text="@string/btn_reset"
                    android:textColor="#A1A1AA"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnSave"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:background="@drawable/bg_save_btn"
                    android:paddingHorizontal="16dp"
                    android:text="@string/btn_save"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/saveResultPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            android:background="@drawable/bg_save_result"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/saved_photo_message"
                android:textColor="#B9D9C9"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/btnViewSaved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:textColor="#B6AAFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="@string/view_saved_photo" />
        </LinearLayout>
    </LinearLayout>

    <!-- 사진 프리뷰 영역 (화면의 대부분을 차지) -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/bottomControlPanel">

        <com.quickbeauty.app.BeautyPreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 원본 비교 중 뱃지 (터치하고 있을 때만 상단 중앙에 작게 표시) -->
        <TextView
            android:id="@+id/badgeOriginal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_frosted_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp"
            android:text="@string/badge_original"
            android:textColor="#E4E4E7"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 첫 1~2회만 떴다가 부드럽게 사라지는 코치마크 -->
        <TextView
            android:id="@+id/hintCoachMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="20dp"
            android:layout_marginHorizontal="16dp"
            android:gravity="center"
            android:background="@drawable/bg_frosted_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="7dp"
            android:text="@string/coach_mark_hold_to_compare"
            android:textColor="#A1A1AA"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 로딩 바 -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="#3B82F6"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 하단 2단 조절 패널 (1단: 탭, 2단: 슬라이더+숫자) -->
    <LinearLayout
        android:id="@+id/bottomControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_panel"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="6dp">

        <!-- 1단: 원형 아이콘 탭 (쿨톤, 생기, 작은얼굴, 턱선, 얼굴길이, 어깨, 몸매, 다리길이) -->
        <HorizontalScrollView
            android:id="@+id/tabScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- 1. 쿨톤 -->
                <LinearLayout
                    android:id="@+id/tabCoolTone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="44dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:id="@+id/iconBgCoolTone"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_tab_circle_selected">

                        <ImageView
                            android:id="@+id/iconCoolTone"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tab_cool_tone"
                            android:contentDescription="@string/tab_tone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtTabCoolTone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/tab_tone"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:singleLine="true"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- 2. 생기 -->
                <LinearLayout
                    android:id="@+id/tabVitality"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="44dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:id="@+id/iconBgVitality"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_tab_circle_unselected">

                        <ImageView
                            android:id="@+id/iconVitality"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tab_vitality"
                            android:contentDescription="@string/tab_vitality" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtTabVitality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/tab_vitality"
                        android:textSize="10sp"
                        android:textColor="#71717A"
                        android:singleLine="true"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- 3. 작은얼굴 -->
                <LinearLayout
                    android:id="@+id/tabFaceSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="44dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:id="@+id/iconBgFaceSize"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tab_circle_unselected">

                    <ImageView
                        android:id="@+id/iconFaceSize"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_tab_face_size"
                        android:contentDescription="@string/tab_face_size" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtTabFaceSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/tab_face_size"
                    android:textSize="10sp"
                    android:textColor="#71717A"
                    android:singleLine="true"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 4. 턱선 -->
            <LinearLayout
                android:id="@+id/tabChinSlim"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="44dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:id="@+id/iconBgChinSlim"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tab_circle_unselected">

                    <ImageView
                        android:id="@+id/iconChinSlim"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_tab_chin_slim"
                        android:contentDescription="@string/tab_chin_slim" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtTabChinSlim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/tab_chin_slim"
                    android:textSize="10sp"
                    android:textColor="#71717A"
                    android:singleLine="true"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 5. 얼굴길이 -->
            <LinearLayout
                android:id="@+id/tabFaceLength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="44dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:id="@+id/iconBgFaceLength"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tab_circle_unselected">

                    <ImageView
                        android:id="@+id/iconFaceLength"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_tab_face_length"
                        android:contentDescription="@string/tab_face_length" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtTabFaceLength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/tab_face_length"
                    android:textSize="10sp"
                    android:textColor="#71717A"
                    android:singleLine="true"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 6. 어깨 -->
            <LinearLayout
                android:id="@+id/tabShoulder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="44dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:id="@+id/iconBgShoulder"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tab_circle_unselected">

                    <ImageView
                        android:id="@+id/iconShoulder"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_tab_shoulder"
                        android:contentDescription="@string/tab_shoulder" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtTabShoulder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/tab_shoulder"
                    android:textSize="10sp"
                    android:textColor="#71717A"
                    android:singleLine="true"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 7. 몸매 -->
            <LinearLayout
                android:id="@+id/tabBodySlim"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="44dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:id="@+id/iconBgBodySlim"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tab_circle_unselected">

                    <ImageView
                        android:id="@+id/iconBodySlim"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_tab_body_slim"
                        android:contentDescription="@string/tab_body_slim" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtTabBodySlim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/tab_body_slim"
                    android:textSize="10sp"
                    android:textColor="#71717A"
                    android:singleLine="true"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 8. 다리길이 -->
            <LinearLayout
                android:id="@+id/tabLegStretch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="44dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:id="@+id/iconBgLegStretch"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tab_circle_unselected">

                    <ImageView
                        android:id="@+id/iconLegStretch"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_tab_leg_stretch"
                        android:contentDescription="@string/tab_legs" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtTabLegStretch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/tab_legs"
                    android:textSize="10sp"
                    android:textColor="#71717A"
                    android:singleLine="true"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
        </HorizontalScrollView>

        <!-- 2단: 슬라이더 + 우측 작은 숫자 (나란히 배치) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/seekBarAdjust"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="36dp"
                android:maxHeight="36dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/seekbar_track"
                android:thumb="@drawable/seekbar_thumb"
                android:splitTrack="false"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <TextView
                android:id="@+id/txtParamValue"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:text="0"
                android:textColor="#E4E4E7"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
